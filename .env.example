# ==============================================================================
# MONTASCAN - ENVIRONMENT CONFIGURATION TEMPLATE
# Smart QR-Based Attendance Management System for Colegio de Montalban
# ==============================================================================
# Note: Copy this file to .env (or .env.local for Next.js) and fill in your actual values.
# NEVER commit your production .env file or Supabase service role key to source control!

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Free tier project URL and keys obtained from: https://app.supabase.com/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Flutter App Configuration (Used in mobile/lib/core/constants/app_constants.dart or dart-define)
# flutter run --dart-define=SUPABASE_URL=https://your-project-id.supabase.co --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi...
FLUTTER_SUPABASE_URL=https://your-project-id.supabase.co
FLUTTER_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# ATTENDANCE POLICY CONFIGURATION
# ------------------------------------------------------------------------------
# QR Token expiration in seconds (default: 20 seconds)
NEXT_PUBLIC_QR_ROTATION_INTERVAL_SECONDS=20

# Minutes after session start before a scan is categorized as 'late' instead of 'present' (default: 15 minutes)
NEXT_PUBLIC_LATE_THRESHOLD_MINUTES=15

# Timezone (Philippines Standard Time / Asia/Manila)
NEXT_PUBLIC_SCHOOL_TIMEZONE=Asia/Manila

# ------------------------------------------------------------------------------
# ADMIN WEB CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
